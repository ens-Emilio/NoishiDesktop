{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@noishi/rpc-bridge": [
        "../../packages/rpc-bridge/src/index.ts"
      ],
      "@noishi/noishi-sdk": [
        "../../packages/noishi-sdk/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/rpc-bridge/src",
    "../../packages/noishi-sdk/src"
  ]
}