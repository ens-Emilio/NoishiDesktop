{
  "manifest_version": 3,
  "name": "Noishi",
  "version": "0.1.0",
  "description": "Compartilhe a p\u00e1gina atual ou o texto selecionado com o Noishi Desktop.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Enviar para Noishi",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
