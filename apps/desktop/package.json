{
  "name": "noishi-desktop",
  "version": "0.1.0",
  "description": "Noishi Desktop Electron app",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "package": "electron-vite build && electron-builder --linux AppImage deb --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^10.15.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.19",
    "ws": "^8.22.2"
  },
  "dependencies": {
    "@noishi/noishi-sdk": "*",
    "@noishi/rpc-bridge": "*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "com.noishi.desktop",
    "productName": "Noishi",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        "deb"
      ],
      "category": "Development",
      "icon": "build/icons",
      "desktop": {
        "Name": "Noishi",
        "Comment": "Noishi coding agent desktop",
        "StartupWMClass": "com.noishi.desktop",
        "MimeType": "x-scheme-handler/noishi;application/x-noishi-package;"
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "afterInstall": "build/after-install.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libsecret-1-0",
        "xdg-utils"
      ]
    },
    "extraFiles": [
      {
        "from": "build/search-provider",
        "to": "search-provider"
      },
      {
        "from": "native-host",
        "to": "native-host"
      },
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "files": [
      "out/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false
  },
  "author": {
    "name": "Noishi",
    "email": "noishi@local"
  },
  "homepage": "https://noishi.local"
}
