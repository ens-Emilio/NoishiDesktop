{
  "name": "noishi-desktop",
  "version": "0.1.0",
  "description": "Noishi Desktop - Electron shell for the Noishi coding agent",
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "apps/desktop/out/main/index.js",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace apps/desktop",
    "check": "tsc --noEmit -p apps/desktop",
    "package": "npm run package --workspace apps/desktop",
    "start": "electron apps/desktop",
    "lint": "eslint .",
    "probe:contract": "node probe/rpc-contract.mjs",
    "probe:review": "node probe/review-contract.mjs",
    "probe:insights": "node probe/insights-contract.mjs",
    "probe:smoke": "node probe/smoke.mjs",
    "probe:panels": "node probe/panels.mjs",
    "probe:a11y": "node probe/a11y.mjs",
    "probe:sandbox": "node probe/sandbox-e2e.mjs",
    "probe:rewind": "node probe/rewind-e2e.mjs",
    "probe:review-e2e": "node probe/review-e2e.mjs",
    "probe:git": "node probe/git-e2e.mjs",
    "probe:system": "node probe/system-e2e.mjs",
    "probe:toolchain": "node probe/toolchain-e2e.mjs",
    "probe:contrast": "node probe/contrast-check.mjs",
    "probe:press": "node probe/press-check.mjs",
    "probe:shot": "node probe/finish-shot.mjs",
    "probe:window": "node probe/window-controls.mjs"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true,
    "better-sqlite3@13.2.0": true
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "ws": "^8.22.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "better-sqlite3": "^13.2.0",
    "hono": "^4.13.19"
  }
}
